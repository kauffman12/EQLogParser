<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>EQLogParserTest</RootNamespace>
    <AssemblyName>EQLogParser.Test</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Test-only, and it ships nothing: XAML stores an enum literal as TEXT in the BAML and resolves it at window load,
      so a glyph name that is not a member of FontAwesome5.EFontAwesomeIcon builds at zero warnings and throws
      XamlParseException when MainWindow opens. The enum lives in the portable FontAwesome5.dll, which is what lets
      XamlIconNameTest run on Linux, where the app itself cannot.
    -->
    <PackageReference Include="FontAwesome5" Version="2.1.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EQLogParser.Core\EQLogParser.Core.csproj" />
    <ProjectReference Include="..\EQLogParser.Utils\EQLogParser.Utils.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Combat-log data files (spells.txt, npcs.txt, ...) needed by EQDataStore in tests. -->
    <None Include="..\EQLogParser\data\**" Link="data\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- NAG conversion fixtures loaded via GetManifestResourceStream (see NagUtilTriggerImportTest). -->
    <EmbeddedResource Include="src\util\fixtures\nag\*.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Checked-in mini test fixtures (kept small on purpose; real log/chat files are never
         committed — derive/mini-fight.txt is hand-synthesized in EQ log format). Copied to bin
         as mini-data\... -->
    <None Include="data\**" Link="mini-data\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
