<Project>

  <!--
    KokoroSharp ships all 157 bundled voice embeddings (~79MB) and its buildTransitive/KokoroSharp.targets
    CopyContent target drops them into the OutputPath of every project that consumes the package transitively.
    Microsoft.Common.targets imports NuGet's *.nuget.g.targets before this file, so redefining CopyContent here wins
    and lets us copy only the set we want to ship.

    KokoroVoiceManager.LoadVoicesFromPath(path) lists whatever .npy files exist in the directory it is given, and at
    run time that directory is the downloaded Kokoro pack, so an unshipped voice is simply never offered and nothing
    in the app needs to know about the set. What lands in the build output is the staging source for
    scripts/Build-TtsPack.ps1 -Sync: this is how the shipped voice set gets into the published pack rather than into
    the installer.

    Only the app's own output is that staging source, so only the app gets the folder. KokoroSharp reaches the WPF test
    and BackupUtil outputs transitively as well, and copying embeddings there too bought nothing but ~11MB per output
    that no code reads; a stray folder in one of those outputs is now deleted rather than refreshed.

    KokoroVoicePrefixes selects the shipped voices by filename prefix; add prefixes to widen the picker:
      bf bm  British English   ef em  Spanish     ff fm  French     hf hm  Hindi
      if im  Italian           pf pm  Portuguese  jf jm  Japanese   zf zm  Mandarin
    Mandarin lives in voices\voices-zh (+51MB), which is why it is left out here as well as by prefix.
    MisakiSharp already carries the phonemizer data for every language, so a wider set costs embeddings only
    (~0.5MB per voice); the model itself speaks all locales either way.
  -->
  <PropertyGroup>
    <KokoroVoicePrefixes>af;am</KokoroVoicePrefixes>
  </PropertyGroup>

  <Target Name="CopyContent" AfterTargets="Build">
    <PropertyGroup>
      <!-- The one output Build-TtsPack.ps1 -Sync reads. -->
      <_KokoroVoiceStaging Condition="'$(MSBuildProjectName)' == 'EQLogParser' And Exists('$(OutputPath)KokoroSharp.dll')">true</_KokoroVoiceStaging>
    </PropertyGroup>

    <!-- Everything else that has one: left behind by the builds that ran before this was scoped to the app. -->
    <RemoveDir Directories="$(OutputPath)voices"
               Condition="'$(_KokoroVoiceStaging)' != 'true' And Exists('$(OutputPath)voices')" />

    <ItemGroup Condition="'$(_KokoroVoiceStaging)' == 'true'">
      <_KokoroPrefix Include="$(KokoroVoicePrefixes)" />
      <!-- ItemGroup batching, one glob per prefix: wildcards only expand in a literal Include, so the prefixes
           themselves must not contain '*'. -->
      <_KokoroWantedFile Include="$(NuGetPackageRoot)kokorosharp\*\content\voices\%(_KokoroPrefix.Identity)_*.npy" />
      <_KokoroAttributionFile Include="$(NuGetPackageRoot)kokorosharp\*\content\voices\LICENSE" />
      <!-- Apache-2.0 attribution for the Kokoro model and voices -->
      <_KokoroLocalVoiceFile Include="$(OutputPath)voices\%(_KokoroPrefix.Identity)_*.npy" />
      <_KokoroStrayFile Include="$(OutputPath)voices\**\*.*"
                       Exclude="@(_KokoroLocalVoiceFile);$(OutputPath)voices\LICENSE" />
    </ItemGroup>

    <!-- Self-healing: keeps the folder in step with KokoroVoicePrefixes across builds. -->
    <Delete Files="@(_KokoroStrayFile)" Condition="'$(_KokoroVoiceStaging)' == 'true'" />
    <!-- voices-zh is the one subfolder the package ships; Delete leaves directories behind, so drop it explicitly. -->
    <RemoveDir Directories="$(OutputPath)voices\voices-zh"
               Condition="'$(_KokoroVoiceStaging)' == 'true' And Exists('$(OutputPath)voices\voices-zh')" />
    <Copy SourceFiles="@(_KokoroWantedFile);@(_KokoroAttributionFile)" DestinationFolder="$(OutputPath)voices"
          SkipUnchangedFiles="true" Condition="'$(_KokoroVoiceStaging)' == 'true'" />
  </Target>

</Project>
