# Local-only working documents (never commit)
local/
# sample EQ logs used as local perf/verification inputs (never commit)
/eqlog_*.txt
# docs: exactly three documents are maintained in git — DesignNotes.md, CodingStandards.md,
# ReleaseChecklist.md. Everything else under docs/ is a local working document for discussions
# (combat-mirror-design.md, legacy-replacement-map.md, TtsPacks.md, counter-variable-issue.md, …)
# and stays out of the repo; durable decisions belong in DesignNotes.md.
docs/*
!docs/DesignNotes.md
!docs/CodingStandards.md
!docs/ReleaseChecklist.md
# pi-subagents session artifacts
.pi-subagents/
nag/

# Website build output (generated by website/build.py)
website/dist/*.html
website/dist/sitemap.xml
website/dist/feed.xml

# Local virtualenv for the website build script
website/.venv/

__pycache__/
