obj/
bin/
tmp/
.vscode/
.aider*
.opencode

# Local-only working documents (never commit)
local/
# sample EQ logs used as local perf/verification inputs (never commit)
/eqlog_*.txt
# docs: exactly four maintained documents - DesignNotes.md, CodingStandards.md,
# ReleaseChecklist.md and TtsPacks.md (tracked since the speech-pack work; it needs the same
# un-ignore as the others or tooling treats it as disposable). Everything else under docs/ is a local working document for discussions
# (perf-memory-status.md, incremental-summary-refresh.md, combat-mirror-design.md, counter-variable-issue.md, roster-import-plan.md, …)
# and stays out of the repo; durable decisions belong in DesignNotes.md.
# A review session's own summary follows the same rule as an unmaintained docs/ file: it is a working document,
# and its durable half belongs in DesignNotes.md (it duplicates that file otherwise).
/gtp-review.md

docs/*
!docs/DesignNotes.md
!docs/CodingStandards.md
!docs/ReleaseChecklist.md
!docs/TtsPacks.md
# pi-subagents session artifacts
.pi-subagents/
nag/

# Website build output (generated by website/build.py)
website/dist/*.html
website/dist/sitemap.xml
website/dist/feed.xml

# Local virtualenv for the website build script
website/.venv/

__pycache__/

# Working review notes for discussion (not shipped documentation).
gpt-review-*.md
