<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Measurement spike for sharded (byte-range) parsing: see Program.cs. Deliberately NOT in
    EQLogParser.sln so it cannot be shipped by accident while the idea is still being measured.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RangeSpike</AssemblyName>
    <RootNamespace>EQLogParser.Tools</RootNamespace>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../EQLogParser.Core/EQLogParser.Core.csproj" />
  </ItemGroup>
</Project>
