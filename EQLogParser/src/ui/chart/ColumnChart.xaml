<UserControl x:Class="EQLogParser.ColumnChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EQLogParser"
             xmlns:fa="http://schemas.fontawesome.com/icons/">
  <Grid>
    <Grid.Resources>
      <local:ComboBoxItemTemplateSelector x:Key="ComboBoxSelector" />
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="{DynamicResource EQGridTitleHeight}" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Label x:Name="titleLabel" Grid.Row="0" Style="{StaticResource EQTitleStyle}" />
    <ComboBox x:Name="classesList" Grid.Row="0" HorizontalAlignment="Right" Margin="0,0,8,2"
              DropDownClosed="ClassSelectionChanged" ItemTemplateSelector="{StaticResource ComboBoxSelector}">
      <ComboBox.ItemContainerStyle>
        <Style>
          <EventSetter Event="ComboBoxItem.PreviewMouseDown" Handler="ClassPreviewMouseDown" />
        </Style>
      </ComboBox.ItemContainerStyle>
    </ComboBox>
    <Grid x:Name="mainGrid" Grid.Row="1">
      <Grid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Copy As">
            <MenuItem.Icon>
              <fa:ImageAwesome Style="{StaticResource EQIconStyle}" Icon="Solid_Copy" />
            </MenuItem.Icon>
            <MenuItem Header="CSV" Click="CopyCsvClick">
              <MenuItem.Icon>
                <fa:ImageAwesome Style="{StaticResource EQIconStyle}" Icon="Solid_Table" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Image" Click="CreateImageClick">
              <MenuItem.Icon>
                <fa:ImageAwesome Style="{StaticResource EQIconStyle}" Icon="Solid_Image" />
              </MenuItem.Icon>
            </MenuItem>
          </MenuItem>
        </ContextMenu>
      </Grid.ContextMenu>
      <local:BarChartView x:Name="chartView" />
    </Grid>
  </Grid>
</UserControl>
