<UserControl x:Class="EQLogParser.HitFreqChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.com/icons/"
             xmlns:local="clr-namespace:EQLogParser">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="{DynamicResource EQGridTitleHeight}" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
      <ComboBox Margin="0,0,8,2" x:Name="playerList" SelectionChanged="PlayerListSelectionChanged" />
      <ComboBox Margin="0,0,8,2" x:Name="critTypeList" SelectionChanged="CritTypeListSelectionChanged" />
      <ComboBox Margin="0,0,8,2" x:Name="hitTypeList" DisplayMemberPath="Label" SelectionChanged="ListSelectionChanged" />
      <ComboBox Margin="0,0,8,2" x:Name="minFreqList" SelectionChanged="ListSelectionChanged" />
    </StackPanel>
    <local:BarChartView x:Name="chartView" Grid.Row="1">
      <local:BarChartView.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Copy As">
            <MenuItem.Icon>
              <fa:ImageAwesome Icon="Solid_Copy" Style="{StaticResource EQIconStyle}" />
            </MenuItem.Icon>
            <MenuItem Header="CSV" Click="CopyCsvClick">
              <MenuItem.Icon>
                <fa:ImageAwesome Icon="Solid_Table" Style="{StaticResource EQIconStyle}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Image" Click="CreateImageClick">
              <MenuItem.Icon>
                <fa:ImageAwesome Icon="Solid_Image" Style="{StaticResource EQIconStyle}" />
              </MenuItem.Icon>
            </MenuItem>
          </MenuItem>
        </ContextMenu>
      </local:BarChartView.ContextMenu>
    </local:BarChartView>
  </Grid>
</UserControl>
