<UserControl x:Class="EQLogParser.HitFreqChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.com/icons/"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:local="clr-namespace:EQLogParser">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="{DynamicResource EQGridTitleHeight}" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <CheckBox x:Name="estimateDiValues" Content="Est DI Values" IsChecked="True" Margin="8,0,12,2"
                Template="{DynamicResource CustomCheckBoxTemplate}" VerticalAlignment="Center"
                Checked="EstimateDiChanged" Unchecked="EstimateDiChanged"
                ToolTip="Show estimated DI labels and include their values in CSV exports" />
      <Grid Grid.Column="1" ClipToBounds="True">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <syncfusion:SfRangeSlider x:Name="pageSlider" Margin="0,2,20,0" Width="250"
                                    ThumbToolTipPlacement="None" ShowValueLabels="False" FocusVisualStyle="{x:Null}"
                                    SmallChange="1" ValueChanged="PageSliderValueChanged" ToolTip="Scroll through hit values">
            <syncfusion:SfRangeSlider.LayoutTransform>
              <ScaleTransform ScaleX="{DynamicResource EQCheckBoxScale}" ScaleY="{DynamicResource EQCheckBoxScale}" />
            </syncfusion:SfRangeSlider.LayoutTransform>
          </syncfusion:SfRangeSlider>
          <ComboBox Margin="0,0,8,2" x:Name="playerList" SelectionChanged="PlayerListSelectionChanged" />
          <ComboBox Margin="0,0,8,2" x:Name="critTypeList" SelectionChanged="CritTypeListSelectionChanged" />
          <ComboBox Margin="0,0,8,2" x:Name="hitTypeList" DisplayMemberPath="Label" SelectionChanged="ListSelectionChanged" />
          <ComboBox Margin="0,0,8,2" x:Name="minFreqList" SelectionChanged="ListSelectionChanged" />
        </StackPanel>
      </Grid>
    </Grid>
    <local:BarChartView x:Name="chartView" Grid.Row="1">
      <local:BarChartView.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Copy As">
            <MenuItem.Icon>
              <fa:ImageAwesome Icon="Solid_Copy" Style="{StaticResource EQIconStyle}" />
            </MenuItem.Icon>
            <MenuItem Header="CSV" Click="CopyCsvClick">
              <MenuItem.Icon>
                <fa:ImageAwesome Icon="Solid_Table" Style="{StaticResource EQIconStyle}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Image" Click="CreateImageClick">
              <MenuItem.Icon>
                <fa:ImageAwesome Icon="Solid_Image" Style="{StaticResource EQIconStyle}" />
              </MenuItem.Icon>
            </MenuItem>
          </MenuItem>
        </ContextMenu>
      </local:BarChartView.ContextMenu>
    </local:BarChartView>
  </Grid>
</UserControl>
