<UserControl x:Class="EQLogParser.FightTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EQLogParser"
             xmlns:fa="http://schemas.fontawesome.com/icons/"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:sfgrid="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
  <Grid>
    <Grid.Resources>
      <local:TotalFormatConverter x:Key="TotalFormatConverter"/>
      <!-- Same visual row numbering as the current Fight Table (its GridRowHeaderCell template):
           the number is the row's live position, so divider rows count like any row and hidden
           dividers renumber the list - identical semantics means the two grids line up. -->
      <Style TargetType="syncfusion:GridRowHeaderCell">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="syncfusion:GridRowHeaderCell">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <Grid>
                  <TextBlock HorizontalAlignment="Center" FontSize="{DynamicResource EQContentSize}" VerticalAlignment="Center" Text="{Binding RowIndex, RelativeSource={RelativeSource TemplatedParent}}" TextAlignment="Center" />
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="FightRowStyle" TargetType="sfgrid:VirtualizingCellsControl">
        <Style.Triggers>
          <!-- The inactivity divider keeps legacy's own color: ColorRowStyleConverter paints every
               Breaktime row with the warning brush (salmon/dark orange by theme), not the search one. -->
          <DataTrigger Binding="{Binding IsDivider}" Value="True">
            <Setter Property="Background" Value="{DynamicResource EQWarnBackgroundBrush}"/>
          </DataTrigger>
          <!-- The search highlight, legacy's own brush and binding name (Fight.IsSearchResult on the old grid). -->
          <DataTrigger Binding="{Binding IsSearchResult}" Value="True">
            <Setter Property="Background" Value="{DynamicResource EQSearchBackgroundBrush}"/>
          </DataTrigger>
        </Style.Triggers>
        <Setter Property="RowHoverForeground" Value="{DynamicResource ContentForeground}"/>
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="{DynamicResource EQFightGridTitleHeight}"></RowDefinition>
      <RowDefinition Height="300*" />
    </Grid.RowDefinitions>
    <!-- Header order like the legacy table: search first, then the display checkboxes. There is no Re-derive
         button - legacy has none, and nothing needed one: every trigger refreshes on its own, overrides
         re-derive themselves, and a failed pass retries on a backoff (DeriveEngine). The old strip hung both the
         checkboxes and that button left of the search box, which is what users read as "different UI". -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
      <!-- Find-next, not a filter: typing highlights and scrolls to the matching row so the user can fight
           that event and select its group - hiding rows here would hide the very fights around it. -->
      <TextBox x:Name="fightSearchBox" Margin="4,2,0,2" Width="130" GotFocus="SearchBoxGotFocus" LostFocus="SearchBoxLostFocus" KeyDown="SearchBoxKeyDown" TextChanged="SearchBoxTextChanged"
               ToolTip="Find a fight by name (case-insensitive). Enter / Shift+Enter cycles, Esc clears the highlight"/>
      <CheckBox x:Name="fightShowHp" Margin="14,0,0,2" Template="{StaticResource CustomCheckBoxTemplate}" Checked="ShowHpChanged" Unchecked="ShowHpChanged"
                IsChecked="True" Content="HP" ToolTip="Show Hit Points"/>
      <CheckBox x:Name="fightShowBreaks" Margin="8,0,0,2" Template="{StaticResource CustomCheckBoxTemplate}" Checked="ShowBreakChanged" Unchecked="ShowBreakChanged"
                IsChecked="True" Content="Inactivity" ToolTip="Add Breaks for Inactivity"/>
      <CheckBox x:Name="fightShowTanking" Margin="8,0,0,2" Template="{StaticResource CustomCheckBoxTemplate}" Checked="ShowTankingChanged" Unchecked="ShowTankingChanged"
                IsChecked="True" Content="Tanking" ToolTip="Include Fights with only Tanking data"/>
    </StackPanel>
    <syncfusion:SfDataGrid x:Name="fightGrid"
                           AllowResizingColumns="True"
                           AllowSorting="True"
                           AutoGenerateColumns="False"
                           CurrentCellBorderThickness="0"
                           Grid.Row="1"
                           GridCopyOption="CopyData,IncludeHeaders,IncludeFormat"
                           ItemsSourceChanged="FightGridItemsSourceChanged"
                           GridLinesVisibility="Horizontal"
                           HeaderRowHeight="{DynamicResource EQTableHeaderRowHeight}"
                           IsReadOnly="True"
                           RowHeight="{DynamicResource EQTableRowHeight}"
                           RowHeaderWidth="{DynamicResource EQTableExtendedRowHeaderWidth}"
                           RowStyle="{DynamicResource FightRowStyle}"
                           ContextMenuClosing="GridContextMenuClosing"
                           ContextMenuOpening="GridContextMenuOpening"
                           SelectionChanged="GridSelectionChanged"
                           SelectionMode="Extended"
                           ShowRowHeader="True"
                           SourceType="{x:Type local:DerivedFightRow}">
      <!--
        The same three columns the legacy table shows, in the legacy order (its Fight model keeps "SortId,
        DamageTotal, Name in this order for display"). Duration and hits are not columns there and are not
        columns here: they ride the row tooltip, formatted like legacy's ("Time Alive: Ns"). Identity and rule
        source stay on the row object but off the grid — nearly every row is an NPC, and the columns made the
        list read like a debug view. HP is the rounded damage total, exactly as the legacy header names it.
      -->
      <syncfusion:SfDataGrid.Columns>
        <syncfusion:GridTextColumn x:Name="beginColumn" MappingName="Begin" HeaderText="Initial Hit Time"
                                   TextAlignment="Center" ShowToolTip="True" ToolTipTemplate="{StaticResource TemplateToolTip}"/>
        <syncfusion:GridTextColumn x:Name="damageColumn" MappingName="Damage" HeaderText="HP" ColumnSizer="Auto"
                                   TextAlignment="Right" Padding="4,0,4,0" ShowToolTip="True"
                                   ToolTipTemplate="{StaticResource TemplateToolTip}"
                                   DisplayBinding="{Binding Path=Damage, Converter={StaticResource TotalFormatConverter}}"/>
        <syncfusion:GridTextColumn MappingName="Name" HeaderText="Name" ColumnSizer="AutoLastColumnFill" Padding="4,0,0,0"
                                   ShowToolTip="True" ToolTipTemplate="{StaticResource TemplateToolTip}"/>
      </syncfusion:SfDataGrid.Columns>
      <!--
        R10 (docs/DesignNotes.md → "The name census: what the Names window reads, and what an override costs"): the rules are inference, and a name whose evidence never crosses a
        gate needs a human to say what it is. Applies to every selected row, saves per server, and re-derives -
        see IdentityVerdictMenu.Write for why that is a re-read of the facts rather than an edit of the row.
      -->
      <syncfusion:SfDataGrid.ContextMenu>
        <!--
          Icons and gestures ported from the legacy list's menu, with two legacy verbs earned back and the four identity rows merged:

            - **Refresh** is here for the reason it was written: the still-going fights are selected, the damage summary is open, and the
              raid keeps hitting things. New facts land INSIDE already-selected rows, so no id changes and the selection's own dedupe
              correctly concludes there is nothing to do - RefreshClick's force flag is the whole verb. A derive pass that moves the row
              content stamp already refreshes on its own; this item is "now", not "on the cadence".
            - **Clear All** came back, but NOT as a store wipe - there is no store under a projection, so rows deleted would return on the
              next pass. It is File / Open Monitor over the same file (MainWindow.ClearAllFights): nothing loaded, following from end of
              file, saved identity memory kept.

          What is NOT here: an identity unset. "Set <name> as" writes; taking a verdict back is the Type cell of the Player/NPC Identity
          pane, the app's one unset - and this menu's old "clear" was deleted rather than renamed (docs/DesignNotes.md).
        -->
        <ContextMenu>
          <MenuItem InputGestureText="Ctrl+C" Header="Copy"
                    Command="{Binding Source={x:Static Member=local:ContextMenuCommands.Copy}}"
                    CommandParameter="{Binding Path=PlacementTarget, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ContextMenu}}}">
            <MenuItem.Icon>
              <fa:ImageAwesome Style="{StaticResource EQIconStyle}" Icon="Solid_Copy" />
            </MenuItem.Icon>
          </MenuItem>
          <Separator/>
          <MenuItem x:Name="selectAllItem" InputGestureText="Ctrl+A" Header="Select All" Click="SelectAllClick">
            <MenuItem.Icon>
              <fa:ImageAwesome Style="{StaticResource EQIconStyle}" Icon="Solid_Square" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem x:Name="unselectAllItem" Header="Unselect All" Click="UnselectAllClick">
            <MenuItem.Icon>
              <fa:ImageAwesome Style="{StaticResource EQIconStyle}" Icon="Regular_Square" />
            </MenuItem.Icon>
          </MenuItem>
          <!-- Group = the right-clicked row's SECTION: every fight between its surrounding inactivity rows -
               legacy's group semantics, read off this display list (see SelectGroup for why not fight.GroupId). -->
          <MenuItem x:Name="selectGroupItem" Header="Select Group" Click="SelectGroupClick"
                    ToolTip="Every fight in the same section as the right-clicked row - between its surrounding inactivity rows">
            <MenuItem.Icon>
              <fa:ImageAwesome Style="{StaticResource EQIconStyle}" Icon="Solid_Clone" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem x:Name="unselectGroupItem" Header="Unselect Group" Click="UnselectGroupClick"
                    ToolTip="Remove every fight in the same section as the right-clicked row">
            <MenuItem.Icon>
              <fa:ImageAwesome Style="{StaticResource EQIconStyle}" Icon="Regular_Clone" />
            </MenuItem.Icon>
          </MenuItem>
          <Separator/>
          <!--
            One cascade instead of four "Set as X" rows, built by IdentityVerdictMenu so this menu and the three summary panes show the
            same words in the same order and write through the same door (the header becomes "Set <name> as" when the menu opens).
            Four flat rows could not say which name they meant, and four rows is also how the summaries drifted to a different verb
            ("Set as Verified Player") for the same judgement.
          -->
          <MenuItem x:Name="overrideSetItem" Header="Set as"/>
          <Separator/>
          <!--
            Legacy's Refresh, back for its original reason: you selected the fights that are still going, you are reading the damage
            summary, and the raid is still hitting things. The new facts land inside the rows already selected, so the selection stamp
            can move without any id changing - and this re-runs the boards over them on demand instead of waiting for the next pass.
          -->
          <MenuItem x:Name="refreshItem" Header="Refresh" Click="RefreshClick"
                    ToolTip="Rebuild the summary boards from what is selected right now, including damage that arrived since you last looked.">
            <MenuItem.Icon>
              <fa:ImageAwesome Style="{StaticResource EQIconStyle}" Icon="Solid_SyncAlt" />
            </MenuItem.Icon>
          </MenuItem>
          <Separator/>
          <!--
            Legacy's Clear All, in the shape a projection can honour (see MainWindow.ClearAllFights for why wiping rows
            is not a thing that exists here). THE only "clear" in this menu: the identity take-back that used to sit here
            was deleted rather than renamed - unclaiming a name belongs to the Type cell of the Player/NPC Identity pane,
            and one verb wants one door. It is also the larger action of the two, which is why it is last.
          -->
          <MenuItem x:Name="clearAllItem" Header="Clear All" Click="ClearAllClick"
                    ToolTip="Unload everything this session read and follow the same file from its end - the state a fresh Open Monitor leaves. Saved players, pets and verdicts stay; the log file itself is untouched, so opening it again reads the past back.">
            <MenuItem.Icon>
              <fa:ImageAwesome Style="{StaticResource EQIconStyle}" Icon="Regular_TrashAlt" />
            </MenuItem.Icon>
          </MenuItem>
        </ContextMenu>
      </syncfusion:SfDataGrid.ContextMenu>
    </syncfusion:SfDataGrid>
    <!--
      The loading band over the table area. Legacy's list filled rows AS it parsed (the fight store was fed per
      line, and it scrolled along); the derived list cannot - bulk ingest deliberately parks both derive lanes so
      a 20-second night loads at parse speed rather than queue-lottery with a projection - so during a load this
      window would otherwise show a silent empty grid. The band says what is actually happening on real signals:
      MainWindow's reader pump (byte progress through the file, the same number its own status bar shows) plus
      the session's captured-fact count. The reading phase is deliberately NOT announced here - the status line at
      the top of the application already counts that same pump's percent and seconds, and a second copy inside the
      dock duplicates it without adding anything. It never lies: a snapshot landing takes it down and it stays down
      for the session.
    -->
    <Border x:Name="loadOverlay" Grid.Row="1" Visibility="Collapsed"
            Background="{DynamicResource ContentBackground}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="loadText" HorizontalAlignment="Center" TextAlignment="Center"
                   FontSize="{DynamicResource EQContentSize}"/>
        <ProgressBar x:Name="loadBar" Width="280" Height="10" Margin="0,10,0,6" IsIndeterminate="True"/>
        <TextBlock x:Name="loadDetail" HorizontalAlignment="Center" TextAlignment="Center"
                   FontSize="{DynamicResource EQContentSize}" Opacity="0.75"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
