<UserControl x:Class="EQLogParser.NamesTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EQLogParser"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="900">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid.Resources>
      <!-- The same row-number template every other row-headered table in the app declares (implicit style, plain
           index text at EQContentSize): numbering tracks the live row position. Without it this grid was the only
           one showing Syncfusion's default row header. -->
      <Style TargetType="syncfusion:GridRowHeaderCell">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="syncfusion:GridRowHeaderCell">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <Grid>
                  <TextBlock HorizontalAlignment="Center" FontSize="{DynamicResource EQContentSize}" VerticalAlignment="Center" Text="{Binding RowIndex, RelativeSource={RelativeSource TemplatedParent}}" TextAlignment="Center" />
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>

    <!-- One line of context, because "Unknown" means three different things and the window has to say which. -->
    <DockPanel Grid.Row="0" Margin="4,3,4,3">
      <Button x:Name="namesRefreshButton" DockPanel.Dock="Right" Content="Re-scan" Padding="8,2"
              Click="RefreshClick" ToolTip="Rebuild the census from the captured facts"/>
      <TextBlock x:Name="namesStatusText" VerticalAlignment="Center" FontSize="{DynamicResource EQContentSize}"
                 Text="Names: open a log to classify the names in it"/>
    </DockPanel>

    <syncfusion:SfDataGrid x:Name="namesGrid" Grid.Row="1"
                           AllowResizingColumns="True"
                           AutoGenerateColumns="False"
                           CurrentCellBorderThickness="0"
                           HeaderRowHeight="{DynamicResource EQTableHeaderRowHeight}"
                           RowHeight="{DynamicResource EQTableRowHeight}"
                           RowHeaderWidth="{DynamicResource EQTableRowHeaderWidth}"
                           GridCopyOption="CopyData,IncludeHeaders,IncludeFormat"
                           SelectionMode="Extended"
                           ShowRowHeader="True">
      <syncfusion:SfDataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="This is an NPC" Click="SetNpcClick"/>
          <MenuItem Header="This is a Pet" Click="SetPetClick"/>
          <MenuItem Header="This is a Mercenary" Click="SetMercClick"/>
          <Separator/>
          <MenuItem Header="Not a player (take back the claim)" Click="RejectClick"
                    ToolTip="No identity claim at all: the name stays listed, and neither this log nor an older one will answer for it"/>
          <MenuItem Header="Forget what older logs decided" Click="ClearPriorClick"
                    ToolTip="Removes this server's remembered verdict. Operator verdicts, roster membership and pet mappings are untouched"/>
        </ContextMenu>
      </syncfusion:SfDataGrid.ContextMenu>
      <!--
        Widths are pixels, not grid stars: SfDataGrid's Width is a double, so "1.6*" throws while the column is being
        created and takes the whole window (and the app, which docks it at startup) down with a XamlParseException that
        points at a line of markup and never says what it disliked. Proportion came for free before via ColumnSizer=Star
        above, so dropping it means these numbers are now the layout: roomy where the reading is (Why, Notes, Name),
        tight where the value is short, right-aligned where it is a number - the same shape HealingBreakdown uses.
      -->
      <syncfusion:SfDataGrid.Columns>
        <syncfusion:GridTextColumn HeaderText="Name" MappingName="Name" Width="170"/>
        <syncfusion:GridTextColumn HeaderText="Kind" MappingName="Kind" Width="80"/>
        <!-- The whole point of the window: which rule read what, and when. A verdict with no reason beside it is
             something to guess about; with the code, it is something to check against the log and correct. -->
        <syncfusion:GridTextColumn HeaderText="Why" MappingName="Why" Width="260"/>
        <syncfusion:GridTextColumn HeaderText="Class" MappingName="PlayerClass" Width="95"/>
        <syncfusion:GridTextColumn HeaderText="Owner" MappingName="PetOwner" Width="130"/>
        <syncfusion:GridTextColumn HeaderText="Notes" MappingName="Flags" Width="240"/>
        <syncfusion:GridNumericColumn HeaderText="Damage" MappingName="Damage" NumberDecimalDigits="0" Width="110" TextAlignment="Right"/>
        <syncfusion:GridNumericColumn HeaderText="Healing" MappingName="Healing" NumberDecimalDigits="0" Width="110" TextAlignment="Right"/>
      </syncfusion:SfDataGrid.Columns>
    </syncfusion:SfDataGrid>
  </Grid>
</UserControl>
