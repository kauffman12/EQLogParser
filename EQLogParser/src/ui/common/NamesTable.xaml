<UserControl x:Class="EQLogParser.NamesTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="http://schemas.fontawesome.com/icons/"
             xmlns:local="clr-namespace:EQLogParser"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="900">
  <!-- ONE CHILD, THE GRID. No header row: the dock tab over this pane already says "Player/NPC Identity", and this
       window lives in a narrow slide-out strip on the right where 30 vertical pixels belong to rows, not to repeating the
       tab. Pet Owners is the model — grid, column headers, done. -->
  <Grid>
    <Grid.Resources>
      <!-- Hidden rather than Collapsed: a row that offers no pencil still reserves its width, so the words in the Type
           and Class columns line up whether or not this row can be overruled. See PlaceholderVisibilityConverter. -->
      <local:PlaceholderVisibilityConverter x:Key="PlaceholderVisibilityConverter" />

      <!-- The same row-number template every other row-headered table in the app declares (implicit style, plain
           index text at EQContentSize): numbering tracks the live row position. Without it this grid was the only
           one showing Syncfusion's default row header. -->
      <Style TargetType="syncfusion:GridRowHeaderCell">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="syncfusion:GridRowHeaderCell">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <Grid>
                  <TextBlock HorizontalAlignment="Center" FontSize="{DynamicResource EQContentSize}" VerticalAlignment="Center" Text="{Binding RowIndex, RelativeSource={RelativeSource TemplatedParent}}" TextAlignment="Center" />
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>

    <!--
      And nothing above the grid either. The census counts that used to sit in the caption, and then on its hover, are
      computed as before (ClassificationReport owns them, tests pin them) but have no surface here: this is a list of
      names, not a report header.

      Three controls used to ride at the right of the header, and all three are gone on
      purpose rather than moved:

        "Refresh"  - the list updates itself now. A census that needs a button to look current reads as broken the first
                     time a name is missing; Apply re-runs on every derive pass and on log open/close/clear.
        "Not a player" (Solid_Times) - its whole effect is DelVerdict + Re-derive, which the Type cell's "Clear claim"
                     does in one click on the row it applies to.
        "Forget old log decisions" (Solid_Undo) - same reach, so this too lives in the dropdown: choosing a Type overrules
                     a remembered verdict, and "Clear claim" drops it. The ledger entry itself is removed by both.

      BATCH work - setting a whole block of selected names at once - is not here and never was expressible in a cell: it
      lives in the fight grids' context menu (Set as Player / Mercenary / Pet / NPC, Clear Override). This pane has no
      buttons of any kind left, only the two pencils.
    -->

    <syncfusion:SfDataGrid x:Name="namesGrid"
                           AllowResizingColumns="True"
                           AllowSorting="True"
                           AutoGenerateColumns="False"
                           CurrentCellBorderThickness="0"
                           FrozenColumnCount="1"
                           GridLinesVisibility="Both"
                           HeaderRowHeight="{DynamicResource EQTableHeaderRowHeight}"
                           IsReadOnly="True"
                           RowHeight="{DynamicResource EQTableRowHeight}"
                           RowHeaderWidth="{DynamicResource EQTableRowHeaderWidth}"
                           GridCopyOption="CopyData,IncludeHeaders,IncludeFormat"
                           SelectionMode="Extended"
                           ShowRowHeader="True">
      <syncfusion:SfDataGrid.SortColumnDescriptions>
        <!-- Names ascending, always. The census's own order (raid-side first, then busiest) rearranged rows underneath
             whoever was reading and looking for one name meant scanning a shuffled list; sorting by hand is the whole
             point of a 4,000 row table. -->
        <syncfusion:SortColumnDescription ColumnName="Name" SortDirection="Ascending"/>
      </syncfusion:SfDataGrid.SortColumnDescriptions>
      <!--
        No context menu. Every verdict a right-click used to offer is now the pencil in the Type cell (the same verb,
        the same file), so the menu was a second door to the same room - and a hidden one, since nothing on the row
        hinted at it. What could not live in a cell went to the two icons in the title band.
      -->
      <!--
        Widths are pixels, not grid stars: SfDataGrid's Width is a double, so "1.6*" throws while the column is being
        created and takes the whole window (and the app, which docks it at startup) down with a XamlParseException that
        points at a line of markup and never says what it disliked. The numbers below are only the FIRST paint: the pane
        sizes these from the same theme-scaled variables every other table reads (ApplyColumnWidths, re-run when the
        theme changes), because ThemeConfig cannot answer anything until after this markup has been loaded.

        Four columns in a fixed order — Name, Type, Class, Why: the two you can edit sit together right after the name,
        and WHY is the read-only explanation, so it goes last instead of between the things you click.

        Four columns, and the ones this window used to carry are gone on purpose. Damage/Healing belong on a damage
        board, not on an identity list; Owner is the Pet Owners window's own table (both read PlayerRegistry, so this
        was a second copy of the same pairs); Notes held sentences that were mostly empty and, where they were not, are
        now the WHY cell's tooltip — see ProvenanceFor.
      -->
      <syncfusion:SfDataGrid.Columns>
        <syncfusion:GridTextColumn HeaderText="Name" MappingName="Name" Width="150"/>

        <!--
          Type: the verdict word and the pencil that overrules it, in the shape the Pet Owners mapping grid already uses
          (MainWindow's ownerEditPopup) - click the icon, the combo opens over the cell, picking writes. One dropdown
          instead of five menu items means the whole vocabulary (including "clear my claim") is visible at once instead of
          having to be remembered.
        -->
        <syncfusion:GridTemplateColumn HeaderText="Type" MappingName="Type" Width="90">
          <syncfusion:GridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <!--
                  No pencil where the answer is forced: a summon whose own spelling carries its owner (`Tuona`s ward`) and
                  a spell effect ("A Spell") each have exactly one right Type, and offering three wrong ones beside it is an
                  invitation to break a row nobody can put back. NameRow.Overrulable decides; see CanOverrule.

                  The space is taken either way: PlaceholderVisibilityConverter answers HIDDEN, not Collapsed, so a row with no pencil still reserves
                  the icon's width and every word in this column starts at the same pixel (ARowWithoutAPencilStillPaysForOne).
                -->
                <fa:ImageAwesome Margin="8,1,4,0" Style="{StaticResource EQIconStyle}" Icon="Regular_Edit" Cursor="Hand"
                                 Visibility="{Binding Overrulable, Converter={StaticResource PlaceholderVisibilityConverter}}"
                                 MouseLeftButtonUp="TypeEditMouseLeftButtonUp" ToolTip="Choose what this name is"/>
                <TextBlock VerticalAlignment="Center" Text="{Binding Type}"/>
              </StackPanel>
            </DataTemplate>
          </syncfusion:GridTemplateColumn.CellTemplate>
        </syncfusion:GridTemplateColumn>
        <!--
          Class, with the same pencil as Type - but only on a row where choosing a class MEANS something. Setting one
          writes players.txt (SetDefaultPlayerClass verifies the name as a player), so an NPC row gets no icon: typing a
          mob into the roster is exactly the pollution this window exists to catch. Nor does a Pet or Merc row get one -
          nothing persists mercenaries, and a pet's class belongs to nobody's roster. A name the rules have not placed
          declares itself with Type first; the pencil arrives as soon as the row reads Player (NameRow.ClassEditable).

          It sits BEFORE Why: the columns you can edit stay together right after the Name, and the read-only sentence that explains a verdict goes
          last rather than between two things you click.
        -->
        <syncfusion:GridTemplateColumn HeaderText="Class" MappingName="PlayerClass" Width="100">
          <syncfusion:GridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <fa:ImageAwesome Margin="8,1,4,0" Style="{StaticResource EQIconStyle}" Icon="Regular_Edit" Cursor="Hand"
                                 Visibility="{Binding ClassEditable, Converter={StaticResource PlaceholderVisibilityConverter}}"
                                 MouseLeftButtonUp="ClassEditMouseLeftButtonUp" ToolTip="Choose this player's class"/>
                <TextBlock VerticalAlignment="Center" Text="{Binding PlayerClass}"/>
              </StackPanel>
            </DataTemplate>
          </syncfusion:GridTemplateColumn.CellTemplate>
        </syncfusion:GridTemplateColumn>
        <!--
          The whole point of the window: which rule read what, in TWO WORDS ("Who", "Chat", "Cast", "Healed", "Owner in
          Name" - see WhyWord), with the details demoted to the tooltip. It used to print the rule code ("R15-healed") at
          256 px - wider than the Class column and part of 771 px of fixed startup pixels across the four - to read a
          string nobody could decode without the source open. Then it carried " (earlier)" on every remembered verdict,
          which paid width for something only a hover needs; the cell is bare now and the tooltip ends in "in previous log".
        -->
        <syncfusion:GridTemplateColumn HeaderText="Why" MappingName="Why" Width="110">
          <syncfusion:GridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Why}" FontSize="{DynamicResource EQContentSize}" VerticalAlignment="Center"
                         ToolTip="{Binding Provenance}"/>
            </DataTemplate>
          </syncfusion:GridTemplateColumn.CellTemplate>
        </syncfusion:GridTemplateColumn>
      </syncfusion:SfDataGrid.Columns>
    </syncfusion:SfDataGrid>

    <!--
      The two dropdowns, declared once and re-pointed at whichever cell was clicked (UiElementUtil.OpenCellPopup sizes
      them to the cell and opens the list). Same markup shape as MainWindow's ownerEditPopup/classEditPopup pair - the
      Pet Owners edit - and the class list is MainActions.ClassList, the same source those popups and the menus read.
      The type list is wired in code-behind (IdentityVocabulary.TypeOptions) because its entries are internal records; the
      word shows via DisplayMemberPath and the verdict travels as SelectedValue.
    -->
    <Popup x:Name="typeEditPopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Placement="Mouse">
      <!-- Wired in the constructor rather than x:Static: the entries are IdentityVocabulary.TypeOption records, and that
           table is internal (the words are shared with Core's rules and asserted by tests that run anywhere). -->
      <ComboBox x:Name="typeEditComboBox"
                HorizontalContentAlignment="Stretch"
                DisplayMemberPath="Word" SelectedValuePath="Kind"
                SelectionChanged="TypeSelectionChanged"
                Style="{DynamicResource EQComboBoxStyle}" />
    </Popup>
    <Popup x:Name="classEditPopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Placement="Mouse">
      <ComboBox x:Name="classEditComboBox"
                HorizontalContentAlignment="Stretch"
                ItemsSource="{x:Static local:MainActions.ClassList}"
                SelectionChanged="ClassSelectionChanged"
                Style="{DynamicResource EQComboBoxStyle}" />
    </Popup>
  </Grid>
</UserControl>
