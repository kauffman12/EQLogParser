<UserControl x:Class="EQLogParser.NamesTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EQLogParser"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="900">
  <Grid>
    <Grid.RowDefinitions>
      <!-- The house title bar: every table in the app reserves EQGridTitleHeight for its caption row and docks its
           controls to the right of it (SpellCountTable is the pattern). This row used to be Height="Auto" holding a
           sentence, which made the pane's top band taller than the one above every other grid on screen. -->
      <RowDefinition Height="{DynamicResource EQGridTitleHeight}"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid.Resources>
      <!-- The same row-number template every other row-headered table in the app declares (implicit style, plain
           index text at EQContentSize): numbering tracks the live row position. Without it this grid was the only
           one showing Syncfusion's default row header. -->
      <Style TargetType="syncfusion:GridRowHeaderCell">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="syncfusion:GridRowHeaderCell">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <Grid>
                  <TextBlock HorizontalAlignment="Center" FontSize="{DynamicResource EQContentSize}" VerticalAlignment="Center" Text="{Binding RowIndex, RelativeSource={RelativeSource TemplatedParent}}" TextAlignment="Center" />
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>

    <!-- House title bar, house title, no status line: like the fight list, this pane says nothing about itself while you
         read it (a census summary used to sit here and it made the band look like a report header). What the capture
         holds is on hover - Apply puts the counts in the caption's tooltip, which is also why they are still computed. -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
      <Label x:Name="namesCaption" Content="Names" Style="{StaticResource EQTitleStyle}"
             ToolTip="Every name this capture mentions, and the rule that placed it. This window replaces the old Verified Players and Verified Pets windows."/>
    </StackPanel>
    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
      <!-- One button, because this census is built on demand: nothing about it updates by itself. -->
      <Button x:Name="namesRefreshButton" Content="Refresh" Margin="0,0,8,1" Height="{DynamicResource EQButtonHeight}" Padding="16,0,16,0"
              Click="RefreshClick" ToolTip="Rebuild this list from the captured facts"/>
    </StackPanel>

    <syncfusion:SfDataGrid x:Name="namesGrid" Grid.Row="1"
                           AllowResizingColumns="True"
                           AllowSorting="True"
                           AutoGenerateColumns="False"
                           CurrentCellBorderThickness="0"
                           FrozenColumnCount="1"
                           GridLinesVisibility="Both"
                           HeaderRowHeight="{DynamicResource EQTableHeaderRowHeight}"
                           IsReadOnly="True"
                           RowHeight="{DynamicResource EQTableRowHeight}"
                           RowHeaderWidth="{DynamicResource EQTableRowHeaderWidth}"
                           GridCopyOption="CopyData,IncludeHeaders,IncludeFormat"
                           SelectionMode="Extended"
                           ShowRowHeader="True">
      <syncfusion:SfDataGrid.SortColumnDescriptions>
        <!-- Names ascending, always. The census's own order (raid-side first, then busiest) rearranged rows underneath
             whoever was reading and looking for one name meant scanning a shuffled list; sorting by hand is the whole
             point of a 4,000 row table. -->
        <syncfusion:SortColumnDescription ColumnName="Name" SortDirection="Ascending"/>
      </syncfusion:SfDataGrid.SortColumnDescriptions>
      <syncfusion:SfDataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="This is an NPC" Click="SetNpcClick"/>
          <MenuItem Header="This is a Pet" Click="SetPetClick"/>
          <MenuItem Header="This is a Mercenary" Click="SetMercClick"/>
          <Separator/>
          <MenuItem Header="Not a player (take back the claim)" Click="RejectClick"
                    ToolTip="No identity claim at all: the name stays listed, and neither this log nor an older one will answer for it"/>
          <MenuItem Header="Forget what older logs decided" Click="ClearPriorClick"
                    ToolTip="Removes this server's remembered verdict. Operator verdicts, roster membership and pet mappings are untouched"/>
        </ContextMenu>
      </syncfusion:SfDataGrid.ContextMenu>
      <!--
        Widths are pixels, not grid stars: SfDataGrid's Width is a double, so "1.6*" throws while the column is being
        created and takes the whole window (and the app, which docks it at startup) down with a XamlParseException that
        points at a line of markup and never says what it disliked.

        Four columns, and the ones this window used to carry are gone on purpose. Damage/Healing belong on a damage
        board, not on an identity list; Owner is the Pet Owners window's own table (both read PlayerRegistry, so this
        was a second copy of the same pairs); Notes held sentences that were mostly empty and, where they were not, are
        now the WHY cell's tooltip — see ProvenanceFor.
      -->
      <syncfusion:SfDataGrid.Columns>
        <syncfusion:GridTextColumn HeaderText="Name" MappingName="Name" Width="190"/>
        <syncfusion:GridTextColumn HeaderText="Type" MappingName="Type" Width="90"/>
        <!-- The whole point of the window: which rule read what. The tooltip is the rest of the answer - the spell a
             spell-based verdict rests on, and the few facts about a row that no column can say (that the operator wrote
             it, took it back, or that this log never mentions the name). -->
        <syncfusion:GridTemplateColumn HeaderText="Why" MappingName="Why" Width="320">
          <syncfusion:GridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Why}" FontSize="{DynamicResource EQContentSize}" VerticalAlignment="Center"
                         ToolTip="{Binding Provenance}"/>
            </DataTemplate>
          </syncfusion:GridTemplateColumn.CellTemplate>
        </syncfusion:GridTemplateColumn>
        <syncfusion:GridTextColumn HeaderText="Class" MappingName="PlayerClass" Width="100"/>
      </syncfusion:SfDataGrid.Columns>
    </syncfusion:SfDataGrid>
  </Grid>
</UserControl>
