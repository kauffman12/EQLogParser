<Window x:Class="EQLogParser.FctOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EQLogParser"
        mc:Ignorable="d"
        AllowsTransparency="True"
        Background="#00000000"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display"
        Title="FCT Overlay"
        WindowStartupLocation="CenterScreen"
        Width="800"
        Height="560"
        MinWidth="420"
        MinHeight="300"
        UseLayoutRounding="True"
        WindowStyle="None"
        KeyDown="WindowKeyDown">
  <!-- while configuring, any press that no control or resize band took moves the window; while locked rootBorder is not
       hit-test visible, so there is nothing to press and clicks reach EverQuest -->
  <Grid MouseLeftButtonDown="OverlayDrag">
  <!-- the panel is configure-mode furniture: ApplyLock swaps its background and border to transparent while locked, so playing
       shows numbers over EverQuest with nothing drawn behind them -->
  <!-- About 23 % black, because configure mode is spent looking through this panel at the game: it is the reference you are positioning numbers
       against, and every point of opacity hides more of it. The hairline stays brighter than the fill so the frame is still findable over snow or
       other bright ground. ApplyLock makes both fully transparent while locked, so nothing at all is drawn during a fight. -->
  <Border x:Name="rootBorder" CornerRadius="10" Background="#3A000000" BorderBrush="#99FFFFFF" BorderThickness="1">
    <!-- the top inset clears the 12px resize band above it, so nothing clickable ever sits where a drag for size starts -->
    <Grid Margin="12,16,12,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <!-- hidden, not collapsed, while locked: the header keeps its height so entering configure mode cannot move a single number, and nothing in it
           paints or takes clicks while you are fighting. It reserves that height even then — about 60 px at the theme's own font size — paid
           deliberately: the alternative is a settings row that moves the numbers during the one moment somebody is positioning them.

           Each setting is three lines of its own — name, control, and where it landed underneath — because this panel is going to acquire more settings
           and a layout that grows sideways runs out of window at some width somebody chose. Nothing gets a row to itself: the direction legend sits on
           the same line as the readouts, at the bottom of the band, rather than underneath everything. Everything wraps, so a narrow overlay drops the
           speed dial under the size dial — never a button off the edge. -->
      <Grid x:Name="headerGrid" Grid.Row="0" Margin="2,0,2,6" Visibility="Hidden" TextElement.FontSize="{DynamicResource EQContentSize}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <WrapPanel Orientation="Horizontal" VerticalAlignment="Top">
          <StackPanel Orientation="Vertical">
            <TextBlock x:Name="titleLabel" Text="FCT" FontWeight="Bold" Foreground="#EDEFF2" />
            <ComboBox x:Name="motionCombo" Width="112" Margin="0,3,0,0" HorizontalAlignment="Left"
                      SelectionChanged="MotionChanged" ToolTip="how the numbers move; applies to the ones after this. Parabola is halves-only — it scrolls across a whole region">
              <ComboBoxItem Content="hold" Tag="hold" />
              <ComboBoxItem Content="fountain" Tag="fountain" />
              <ComboBoxItem Content="pulse" Tag="pulse" />
              <ComboBoxItem Content="spray" Tag="spray" />
              <ComboBoxItem x:Name="parabolaItem" Content="parabola" Tag="parabola" />
            </ComboBox>
          </StackPanel>

          <!-- The region scheme, and how it is oriented. The controls after it belong to particular schemes only — which side
               incoming owns is halves' question, which side healing owns is by type's, and bands obeys neither: its protected
               strip owns each side's direction of travel. They collapse with the scheme rather than sit disabled, and nothing
               on the row jumps when they go. -->
          <StackPanel Orientation="Vertical" Margin="18,0,0,0">
            <TextBlock x:Name="layoutLabel" Text="layout" FontWeight="Bold" Foreground="#EDEFF2"
                       ToolTip="where the numbers sit; applies to the ones after this" />
            <ComboBox x:Name="layoutCombo" Width="104" Margin="0,3,0,0" HorizontalAlignment="Left"
                      SelectionChanged="LayoutChanged" ToolTip="halves: one stream per side, how most scrolling combat text ships. by type: healing gets its own column, everything else the other. bands: top and bottom around a clear middle">
              <ComboBoxItem Content="halves" Tag="halves" />
              <ComboBoxItem Content="by type" Tag="bytype" />
              <ComboBoxItem Content="bands" Tag="bands" />
            </ComboBox>
          </StackPanel>

          <StackPanel x:Name="sidePanel" Orientation="Vertical" Margin="18,0,0,0">
            <TextBlock x:Name="sideLabel" Text="incoming" FontWeight="Bold" Foreground="#EDEFF2"
                       ToolTip="which half of the overlay incoming numbers sit in (halves only)" />
            <ComboBox x:Name="sideCombo" Width="76" Margin="0,3,0,0" HorizontalAlignment="Left" SelectionChanged="LayoutChanged">
              <ComboBoxItem Content="left" Tag="left" />
              <ComboBoxItem Content="right" Tag="right" />
            </ComboBox>
          </StackPanel>

          <StackPanel x:Name="healPanel" Orientation="Vertical" Margin="18,0,0,0" Visibility="Collapsed">
            <TextBlock x:Name="healLabel" Text="heals" FontWeight="Bold" Foreground="#EDEFF2"
                       ToolTip="which column healing sits in (by type only)" />
            <ComboBox x:Name="healSideCombo" Width="76" Margin="0,3,0,0" HorizontalAlignment="Left" SelectionChanged="LayoutChanged">
              <ComboBoxItem Content="left" Tag="left" />
              <ComboBoxItem Content="right" Tag="right" />
            </ComboBox>
          </StackPanel>

          <StackPanel x:Name="outDirPanel" Orientation="Vertical" Margin="18,0,0,0">
            <TextBlock x:Name="outDirLabel" Text="yours" FontWeight="Bold" Foreground="#EDEFF2"
                       ToolTip="which way your numbers travel (halves only)" />
            <ComboBox x:Name="outDirCombo" Width="76" Margin="0,3,0,0" HorizontalAlignment="Left" SelectionChanged="LayoutChanged">
              <ComboBoxItem Content="up" Tag="up" />
              <ComboBoxItem Content="down" Tag="down" />
            </ComboBox>
          </StackPanel>

          <StackPanel x:Name="inDirPanel" Orientation="Vertical" Margin="18,0,0,0">
            <TextBlock x:Name="inDirLabel" Text="on you" FontWeight="Bold" Foreground="#EDEFF2"
                       ToolTip="which way incoming numbers travel (halves only)" />
            <ComboBox x:Name="inDirCombo" Width="76" Margin="0,3,0,0" HorizontalAlignment="Left" SelectionChanged="LayoutChanged">
              <ComboBoxItem Content="up" Tag="up" />
              <ComboBoxItem Content="down" Tag="down" />
            </ComboBox>
          </StackPanel>

          <!-- Both tracks read the same way: bold mark at each end, and the number underneath saying where you landed, with its own percent sign so it is
               not a bare 50. Bigger and faster at the right. Speed is percent of the time a number spends on screen (so +50 % takes half as long and
               −50 % lasts half again as long), measured from the middle of the band that proved usable — see FctScale for that and for why it divides. -->
          <StackPanel x:Name="sizeDial" Orientation="Vertical" Margin="18,0,0,0">
            <TextBlock x:Name="sizeLabel" Text="size" FontWeight="Bold" Foreground="#EDEFF2"
                       ToolTip="how big the numbers are; applies to the ones after this (double-click resets)" />
            <Grid Margin="0,1,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="sizeMinus" Text="&#8722;" FontWeight="Bold" Foreground="#C6CBD1" VerticalAlignment="Center" />
              <Slider x:Name="sizeSlider" Grid.Column="1" Width="96" Margin="5,0,5,0" Minimum="0.5" Maximum="1.5" Value="1"
                      IsSnapToTickEnabled="True" TickFrequency="0.05" SmallChange="0.05" LargeChange="0.1" HorizontalAlignment="Center"
                      VerticalAlignment="Center" ValueChanged="ScaleChanged" MouseLeftButtonUp="ScaleReleased" />
              <TextBlock x:Name="sizePlus" Grid.Column="2" Text="+" FontWeight="Bold" Foreground="#C6CBD1" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="sizeValue" FontWeight="Bold" Foreground="#D4D8DD" HorizontalAlignment="Center" TextAlignment="Center" />
          </StackPanel>

          <StackPanel x:Name="speedDial" Orientation="Vertical" Margin="18,0,0,0">
            <TextBlock x:Name="speedLabel" Text="speed" FontWeight="Bold" Foreground="#EDEFF2"
                       ToolTip="how quickly a number shows and clears; applies to the ones after this (double-click resets)" />
            <Grid Margin="0,1,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="speedMinus" Text="&#8722;" FontWeight="Bold" Foreground="#C6CBD1" VerticalAlignment="Center" />
              <Slider x:Name="speedSlider" Grid.Column="1" Width="96" Margin="5,0,5,0" Minimum="-50" Maximum="50" Value="0"
                      IsSnapToTickEnabled="True" TickFrequency="5" SmallChange="5" LargeChange="10" HorizontalAlignment="Center"
                      VerticalAlignment="Center" ValueChanged="ScaleChanged" MouseLeftButtonUp="ScaleReleased" />
              <TextBlock x:Name="speedPlus" Grid.Column="2" Text="+" FontWeight="Bold" Foreground="#C6CBD1" VerticalAlignment="Center" />
              <!-- The examples are the point of configure mode, but not while you are trying to place the overlay in the middle of a fight and want to
                   see only what is really landing. It is a view aid for this session, not a setting: nothing writes it, and it comes back on the next
                   time setup opens. -->
              <CheckBox x:Name="sampleDataCheck" Grid.Column="3" Content="sample data" IsChecked="True" Margin="14,0,0,0"
                        VerticalAlignment="Center" Foreground="#EDEFF2" Checked="SampleDataChanged" Unchecked="SampleDataChanged"
                        ToolTip="the demo numbers that play while configuring; turn off to set this up over a real fight" />
            </Grid>
            <TextBlock x:Name="speedValue" FontWeight="Bold" Foreground="#D4D8DD" HorizontalAlignment="Center" TextAlignment="Center" />
          </StackPanel>

          <!-- The damage threshold, offered as a ladder instead of a dial: its job is "stop the white noise", which wants
               three glances rather than eighty positions. Damage only — heals and words like Miss or Resist are information,
               not volume, and are never hidden. What it hides is counted in the stats line, because a filter should be able
               to say what it cost. -->
          <StackPanel x:Name="thresholdPanel" Orientation="Vertical" Margin="18,0,0,0">
            <TextBlock x:Name="thresholdLabel" Text="hide under" FontWeight="Bold" Foreground="#EDEFF2"
                       ToolTip="stop showing your damage numbers below this value (heals and words like Miss are never hidden); hidden hits are counted, not lost" />
            <ComboBox x:Name="thresholdCombo" Width="76" Margin="0,3,0,0" HorizontalAlignment="Left" SelectionChanged="ThresholdChanged">
              <ComboBoxItem Content="off" Tag="0" />
              <ComboBoxItem Content="250" Tag="250" />
              <ComboBoxItem Content="500" Tag="500" />
              <ComboBoxItem Content="1k" Tag="1000" />
              <ComboBoxItem Content="2k" Tag="2000" />
              <ComboBoxItem Content="5k" Tag="5000" />
            </ComboBox>
          </StackPanel>

          <!-- Direction is the one thing worth spelling out, and it shares the bottom line with the readouts rather than costing a row: two arrows say
               what the bands mean, where what used to sit here was a sentence about cast bars that nobody read twice. -->
          <!-- Kept in sync with the scheme by code (SetLegend): bands say it with up/down arrows, halves with the sides a
               number sits on. It is the only position explanation on the row, so it has to be true for what is on screen. -->
          <TextBlock x:Name="legendText" Text="&#8592; on you   yours &#8594;" Foreground="#A9B0B7" Margin="18,0,0,0"
                     VerticalAlignment="Bottom" />
        </WrapPanel>

        <!-- Stacked for the same reason as everything else. Two buttons that mean "keep this" and "don't": leaving configure mode without saving is a
             normal way to end it, so it gets a control instead of a sentence explaining a key. Diagnostics go underneath, out of the way. -->
        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top" Margin="14,0,0,0">
          <Button x:Name="saveButton" Content="Save" Padding="12,2" HorizontalAlignment="Stretch" Click="SaveClick"
                  ToolTip="keep these settings and stop configuring" />
          <Button x:Name="cancelButton" Content="Cancel" Padding="12,2" Margin="0,5,0,0" HorizontalAlignment="Stretch" Click="CancelClick"
                  ToolTip="stop configuring without keeping any of this" />
          <TextBlock x:Name="statsText" Foreground="#C6CBD1" Margin="0,7,0,0" HorizontalAlignment="Center" TextAlignment="Center" />
        </StackPanel>
      </Grid>
      <local:FctSkiaCanvas x:Name="fctCanvas" Grid.Row="1" />
    </Grid>
  </Border>
  <!--
       Drag bands for resizing. A transparent, chromeless window gets no resize frame from Windows, and the middle of the overlay
       belongs to the numbers, so the grip is a band along each edge: corners size both axes, edges size one. Sizes settle on the
       values FctResize offers, which is why you cannot make it the wrong shape by accident. Collapsed while locked, because a
       click-through window must not offer anything to click.
  -->
  <Grid x:Name="resizeLayer">
    <Grid.RowDefinitions>
      <RowDefinition Height="12" />
      <RowDefinition Height="*" />
      <RowDefinition Height="12" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="12" />
    </Grid.ColumnDefinitions>
    <Rectangle Grid.Row="0" Grid.Column="0" Fill="Transparent" Cursor="SizeNWSE" Tag="tl" />
    <Rectangle Grid.Row="0" Grid.Column="2" Fill="Transparent" Cursor="SizeNESW" Tag="tr" />
    <Rectangle Grid.Row="2" Grid.Column="0" Fill="Transparent" Cursor="SizeNESW" Tag="bl" />
    <Rectangle Grid.Row="2" Grid.Column="2" Fill="Transparent" Cursor="SizeNWSE" Tag="br" />
    <Rectangle Grid.Row="0" Grid.Column="1" Fill="Transparent" Cursor="SizeNS" Tag="t" />
    <Rectangle Grid.Row="2" Grid.Column="1" Fill="Transparent" Cursor="SizeNS" Tag="b" />
    <Rectangle Grid.Row="1" Grid.Column="0" Fill="Transparent" Cursor="SizeWE" Tag="l" />
    <Rectangle Grid.Row="1" Grid.Column="2" Fill="Transparent" Cursor="SizeWE" Tag="r" />
  </Grid>
  </Grid>
</Window>
