<Window x:Class="EQLogParser.FctOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EQLogParser"
        mc:Ignorable="d"
        AllowsTransparency="True"
        Background="#00000000"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display"
        Title="FCT Overlay"
        WindowStartupLocation="CenterScreen"
        Width="980"
        Height="640"
        UseLayoutRounding="True"
        WindowStyle="None"
        KeyDown="WindowKeyDown">
  <Border x:Name="rootBorder" CornerRadius="10" Background="#350D131A" BorderBrush="#5C7A99" BorderThickness="1">
    <Grid Margin="12,8,12,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <!-- the only interactive band while unlocked: drag to move; locking makes the whole window click-through -->
      <!-- three columns so the header cannot collide with itself: controls on the left, the hint in the stretchable
           middle (it abbreviates on a narrow overlay), stats pinned right. A single-cell Grid of two StackPanels looked
           fine at 980px and overlapped as soon as somebody shrank the window over their HUD. -->
      <Grid Grid.Row="0" Margin="2,0,2,6" MouseLeftButtonDown="HeaderDrag">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" MinWidth="12" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="FCT" FontSize="13" FontWeight="Bold" Foreground="#D6E1EC" VerticalAlignment="Center" />
          <TextBlock Text="motion" Margin="12,0,4,0" VerticalAlignment="Center" FontSize="12" Foreground="#9FB4C8" />
          <ComboBox x:Name="motionCombo" Width="86" FontSize="12" VerticalAlignment="Center" SelectionChanged="MotionChanged"
                    ToolTip="hold: travel, stop, fade in place&#10;fountain: overshoot, then fall (mirrored on the lower band)&#10;pulse: no travel at all, swells where it appears&#10;spray: random cone, then fall&#10;&#10;applies to new hits, so you can switch mid-fight to see which reads best">
            <ComboBoxItem Content="hold" Tag="hold" />
            <ComboBoxItem Content="fountain" Tag="fountain" />
            <ComboBoxItem Content="pulse" Tag="pulse" />
            <ComboBoxItem Content="spray" Tag="spray" />
          </ComboBox>
          <CheckBox x:Name="lockCheck" Content=" lock (click-through)" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#9FB4C8" Checked="LockChanged" Unchecked="LockChanged" />
          <CheckBox x:Name="layoutCheck" Content=" halves (left/right)" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#9FB4C8" ToolTip="Bands: your hits rise above the empty middle strip, hits on you sink below it. Halves: the original left/right split." Checked="LayoutChanged" Unchecked="LayoutChanged" />
        </StackPanel>
        <!-- the hint is the only documentation a player reads mid-fight, so it gets the flexible column and trims
             rather than pushing over the controls; drag events still reach the Grid through it -->
        <TextBlock x:Name="hintText" Grid.Column="1" Margin="14,0,14,0" FontSize="11" Foreground="#6B7A8C"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="statsText" Grid.Column="2" FontSize="12" Foreground="#7FD1FF" VerticalAlignment="Center" />
      </Grid>
      <local:FctSkiaCanvas x:Name="fctCanvas" Grid.Row="1" />
    </Grid>
  </Border>
</Window>
