<Window x:Class="EQLogParser.FctOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EQLogParser"
        mc:Ignorable="d"
        AllowsTransparency="True"
        Background="#00000000"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display"
        Title="FCT Overlay"
        WindowStartupLocation="CenterScreen"
        Width="800"
        Height="560"
        MinWidth="420"
        MinHeight="300"
        UseLayoutRounding="True"
        WindowStyle="None"
        KeyDown="WindowKeyDown">
  <!-- while configuring, any press that no control or resize band took moves the window; while locked rootBorder is not
       hit-test visible, so there is nothing to press and clicks reach EverQuest -->
  <Grid MouseLeftButtonDown="OverlayDrag">
  <!-- the panel is configure-mode furniture: ApplyLock swaps its background and border to transparent while locked, so playing
       shows numbers over EverQuest with nothing drawn behind them -->
  <!-- translucent on purpose: this panel sits over the game, and a wall of black hides what you are trying to look at while
       configuring it. The hairline is brighter than the fill so the frame is still findable against a bright zone. -->
  <Border x:Name="rootBorder" CornerRadius="10" Background="#73000000" BorderBrush="#8CFFFFFF" BorderThickness="1">
    <!-- the top inset clears the 12px resize band above it, so nothing clickable ever sits where a drag for size starts -->
    <Grid Margin="12,16,12,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <!-- hidden, not collapsed, while locked: the header keeps its height so entering configure mode cannot move a single number,
           and nothing in it paints or takes clicks while you are fighting. Its second row costs the canvas about 24 px even then.
           That is a real cost, paid deliberately: the alternative is a settings row that moves the numbers during the one moment
           somebody is positioning them. -->
      <Grid x:Name="headerGrid" Grid.Row="0" Margin="2,0,2,6">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- three columns so this row cannot collide with itself: controls left, spare space in the middle, diagnostics right.
             A single-cell pile looked fine at 980px and overlapped as soon as somebody shrank the window. -->
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="12" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="FCT" FontSize="13" FontWeight="Bold" Foreground="#EDEFF2" VerticalAlignment="Center" />
            <ComboBox x:Name="motionCombo" Width="86" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"
                      SelectionChanged="MotionChanged" ToolTip="motion style — applies to numbers from now on">
              <ComboBoxItem Content="hold" Tag="hold" />
              <ComboBoxItem Content="fountain" Tag="fountain" />
              <ComboBoxItem Content="pulse" Tag="pulse" />
              <ComboBoxItem Content="spray" Tag="spray" />
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="statsText" FontSize="12" Foreground="#C6CBD1" VerticalAlignment="Center" />
            <Button x:Name="saveButton" Content="Save" Margin="12,0,0,0" Padding="12,2" FontSize="12" Click="SaveClick"
                    ToolTip="keep these settings and stop configuring — Esc leaves them unsaved" />
          </StackPanel>
        </Grid>
        <!-- The two dials a player gets, ±30 % in 5 % steps so the shipped default is a place to park rather than a value to hit
             by eye. Both preview onto the examples as they move and are written to settings.ini only by Save. -->
        <Grid Grid.Row="1" Margin="0,6,0,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="size" FontSize="12" Foreground="#A9B0B7" VerticalAlignment="Center" />
            <Slider x:Name="sizeSlider" Width="82" Margin="7,0,0,0" Minimum="0.7" Maximum="1.3" Value="1"
                    IsSnapToTickEnabled="True" TickFrequency="0.05" SmallChange="0.05" LargeChange="0.1"
                    VerticalAlignment="Center" ValueChanged="ScaleChanged" MouseLeftButtonUp="ScaleDoubleClick"
                    ToolTip="text size — 30 % smaller to 30 % larger than shipped (double-click resets)" />
            <TextBlock x:Name="sizeValue" Width="36" Margin="5,0,0,0" FontSize="12" Foreground="#C6CBD1" VerticalAlignment="Center" />
            <TextBlock Text="time" Margin="14,0,0,0" FontSize="12" Foreground="#A9B0B7" VerticalAlignment="Center" />
            <Slider x:Name="timeSlider" Width="82" Margin="7,0,0,0" Minimum="0.7" Maximum="1.3" Value="1"
                    IsSnapToTickEnabled="True" TickFrequency="0.05" SmallChange="0.05" LargeChange="0.1"
                    VerticalAlignment="Center" ValueChanged="ScaleChanged" MouseLeftButtonUp="ScaleDoubleClick"
                    ToolTip="how long a number shows and finishes — 30 % quicker to 30 % longer (double-click resets)" />
            <TextBlock x:Name="timeValue" Width="36" Margin="5,0,0,0" FontSize="12" Foreground="#C6CBD1" VerticalAlignment="Center" />
          </StackPanel>
          <!-- direction is the one thing worth typing. Two arrows say it; what used to sit here was a sentence about cast bars
               and mouse buttons that nobody read twice -->
          <TextBlock Text="↑ yours   ↓ on you" FontSize="12" Foreground="#A9B0B7" VerticalAlignment="Center"
                     HorizontalAlignment="Right" />
        </Grid>
      </Grid>
      <local:FctSkiaCanvas x:Name="fctCanvas" Grid.Row="1" />
    </Grid>
  </Border>
  <!--
       Drag bands for resizing. A transparent, chromeless window gets no resize frame from Windows, and the middle of the overlay
       belongs to the numbers, so the grip is a band along each edge: corners size both axes, edges size one. Sizes settle on the
       values FctResize offers, which is why you cannot make it the wrong shape by accident. Collapsed while locked, because a
       click-through window must not offer anything to click.
  -->
  <Grid x:Name="resizeLayer">
    <Grid.RowDefinitions>
      <RowDefinition Height="12" />
      <RowDefinition Height="*" />
      <RowDefinition Height="12" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="12" />
    </Grid.ColumnDefinitions>
    <Rectangle Grid.Row="0" Grid.Column="0" Fill="Transparent" Cursor="SizeNWSE" Tag="tl" />
    <Rectangle Grid.Row="0" Grid.Column="2" Fill="Transparent" Cursor="SizeNESW" Tag="tr" />
    <Rectangle Grid.Row="2" Grid.Column="0" Fill="Transparent" Cursor="SizeNESW" Tag="bl" />
    <Rectangle Grid.Row="2" Grid.Column="2" Fill="Transparent" Cursor="SizeNWSE" Tag="br" />
    <Rectangle Grid.Row="0" Grid.Column="1" Fill="Transparent" Cursor="SizeNS" Tag="t" />
    <Rectangle Grid.Row="2" Grid.Column="1" Fill="Transparent" Cursor="SizeNS" Tag="b" />
    <Rectangle Grid.Row="1" Grid.Column="0" Fill="Transparent" Cursor="SizeWE" Tag="l" />
    <Rectangle Grid.Row="1" Grid.Column="2" Fill="Transparent" Cursor="SizeWE" Tag="r" />
  </Grid>
  </Grid>
</Window>
