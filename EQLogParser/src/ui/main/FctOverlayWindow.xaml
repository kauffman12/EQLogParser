<Window x:Class="EQLogParser.FctOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EQLogParser"
        mc:Ignorable="d"
        AllowsTransparency="True"
        Background="#00000000"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display"
        Title="FCT Overlay"
        WindowStartupLocation="CenterScreen"
        Width="800"
        Height="560"
        MinWidth="420"
        MinHeight="300"
        UseLayoutRounding="True"
        WindowStyle="None"
        KeyDown="WindowKeyDown">
  <!-- while configuring, any press that no control or resize band took moves the window; while locked rootBorder is not
       hit-test visible, so there is nothing to press and clicks reach EverQuest -->
  <Grid MouseLeftButtonDown="OverlayDrag">
  <!-- the panel is configure-mode furniture: ApplyLock swaps its background and border to transparent while locked, so playing
       shows numbers over EverQuest with nothing drawn behind them -->
  <!-- About 23 % black, because configure mode is spent looking through this panel at the game: it is the reference you are positioning numbers
       against, and every point of opacity hides more of it. The hairline stays brighter than the fill so the frame is still findable over snow or
       other bright ground. ApplyLock makes both fully transparent while locked, so nothing at all is drawn during a fight. -->
  <Border x:Name="rootBorder" CornerRadius="10" Background="#3A000000" BorderBrush="#99FFFFFF" BorderThickness="1">
    <!-- the top inset clears the 12px resize band above it, so nothing clickable ever sits where a drag for size starts -->
    <Grid Margin="12,16,12,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <!-- hidden, not collapsed, while locked: the header keeps its height so entering configure mode cannot move a single number, and nothing in it
           paints or takes clicks while you are fighting. It reserves its two rows even then - about 24 px of canvas, paid deliberately: the
           alternative is a settings row that moves the numbers during the one moment somebody is positioning them. -->
      <Grid x:Name="headerGrid" Grid.Row="0" Margin="2,0,2,6" Visibility="Hidden" TextElement.FontSize="{DynamicResource EQContentSize}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Everything you can set is on one line: the style and both dials on the left, Save at the right end of the same line. The left cluster is a
             WrapPanel rather than a StackPanel so that a narrow window drops the speed dial under the size dial instead of running it out past the
             edge - a clipped Save button is the one failure mode this row cannot have, and clipping is what a fixed layout does at some width that
             somebody chose. Font sizes come from the app's own font setting in code (ApplyTypography): this window used to carry a fixed 12 px, which
             looked like another program's overlay sitting next to a theme set to 13 pt and up. -->
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="titleLabel" Text="FCT" FontWeight="Bold" Foreground="#EDEFF2" VerticalAlignment="Center" />
            <ComboBox x:Name="motionCombo" Width="104" Margin="8,0,0,0" VerticalAlignment="Center"
                      SelectionChanged="MotionChanged" ToolTip="how the numbers move; applies to the ones after this">
              <ComboBoxItem Content="hold" Tag="hold" />
              <ComboBoxItem Content="fountain" Tag="fountain" />
              <ComboBoxItem Content="pulse" Tag="pulse" />
              <ComboBoxItem Content="spray" Tag="spray" />
            </ComboBox>

            <!-- Both dials are +/- 50 % in their own unit, bigger and faster at the right end. The mark beside the thumb is the part you consult while
                 dragging, so that is what carries the size; the percentage confirms where you landed. Right means bigger for size and faster for
                 speed: this dial used to be called "time", which made the right-hand end the slower one, and that was reported as confusing rather
                 than noticed - see FctScale for why speed divides rather than subtracts. -->
            <TextBlock x:Name="sizeLabel" Text="size" Margin="18,0,0,0" FontWeight="Bold" Foreground="#EDEFF2" VerticalAlignment="Center"
                       ToolTip="how big the numbers are; applies to the ones after this (double-click resets)" />
            <TextBlock x:Name="sizeMinus" Text="&#8722;" Margin="9,0,0,0" FontWeight="Bold" Foreground="#C6CBD1" VerticalAlignment="Center" />
            <Slider x:Name="sizeSlider" Width="96" Margin="5,0,0,0" Minimum="0.5" Maximum="1.5" Value="1" IsSnapToTickEnabled="True"
                    TickFrequency="0.05" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center"
                    ValueChanged="ScaleChanged" MouseLeftButtonUp="ScaleReleased" />
            <TextBlock x:Name="sizePlus" Text="+" Margin="5,0,0,0" FontWeight="Bold" Foreground="#C6CBD1" VerticalAlignment="Center" />
            <TextBlock x:Name="sizeValue" Width="42" Margin="7,0,0,0" Foreground="#A9B0B7" VerticalAlignment="Center" />

            <TextBlock x:Name="speedLabel" Text="speed" Margin="18,0,0,0" FontWeight="Bold" Foreground="#EDEFF2" VerticalAlignment="Center"
                       ToolTip="how quickly a number shows and clears; applies to the ones after this (double-click resets)" />
            <TextBlock x:Name="speedMinus" Text="&#8722;" Margin="9,0,0,0" FontWeight="Bold" Foreground="#C6CBD1" VerticalAlignment="Center" />
            <Slider x:Name="speedSlider" Width="96" Margin="5,0,0,0" Minimum="0.5" Maximum="1.5" Value="1" IsSnapToTickEnabled="True"
                    TickFrequency="0.05" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center"
                    ValueChanged="ScaleChanged" MouseLeftButtonUp="ScaleReleased" />
            <TextBlock x:Name="speedPlus" Text="+" Margin="5,0,0,0" FontWeight="Bold" Foreground="#C6CBD1" VerticalAlignment="Center" />
            <TextBlock x:Name="speedValue" Width="42" Margin="7,0,0,0" Foreground="#A9B0B7" VerticalAlignment="Center" />
          </WrapPanel>

          <Button x:Name="saveButton" Grid.Column="1" Content="Save" Margin="12,0,0,0" Padding="12,2" VerticalAlignment="Center" Click="SaveClick"
                  ToolTip="keep these settings and stop configuring; Esc leaves them unsaved" />
        </Grid>

        <!-- Direction is the one thing worth spelling out, so it gets the second line to itself: two arrows say what the bands mean, where what used
             to sit here was a sentence about cast bars that nobody read twice. Diagnostics sit at the right end of the same line. -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
          <TextBlock x:Name="legendText" Text="&#8593; yours   &#8595; on you" Foreground="#A9B0B7" VerticalAlignment="Center" />
          <TextBlock x:Name="statsText" Foreground="#C6CBD1" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
      </Grid>
      <local:FctSkiaCanvas x:Name="fctCanvas" Grid.Row="1" />
    </Grid>
  </Border>
  <!--
       Drag bands for resizing. A transparent, chromeless window gets no resize frame from Windows, and the middle of the overlay
       belongs to the numbers, so the grip is a band along each edge: corners size both axes, edges size one. Sizes settle on the
       values FctResize offers, which is why you cannot make it the wrong shape by accident. Collapsed while locked, because a
       click-through window must not offer anything to click.
  -->
  <Grid x:Name="resizeLayer">
    <Grid.RowDefinitions>
      <RowDefinition Height="12" />
      <RowDefinition Height="*" />
      <RowDefinition Height="12" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="12" />
    </Grid.ColumnDefinitions>
    <Rectangle Grid.Row="0" Grid.Column="0" Fill="Transparent" Cursor="SizeNWSE" Tag="tl" />
    <Rectangle Grid.Row="0" Grid.Column="2" Fill="Transparent" Cursor="SizeNESW" Tag="tr" />
    <Rectangle Grid.Row="2" Grid.Column="0" Fill="Transparent" Cursor="SizeNESW" Tag="bl" />
    <Rectangle Grid.Row="2" Grid.Column="2" Fill="Transparent" Cursor="SizeNWSE" Tag="br" />
    <Rectangle Grid.Row="0" Grid.Column="1" Fill="Transparent" Cursor="SizeNS" Tag="t" />
    <Rectangle Grid.Row="2" Grid.Column="1" Fill="Transparent" Cursor="SizeNS" Tag="b" />
    <Rectangle Grid.Row="1" Grid.Column="0" Fill="Transparent" Cursor="SizeWE" Tag="l" />
    <Rectangle Grid.Row="1" Grid.Column="2" Fill="Transparent" Cursor="SizeWE" Tag="r" />
  </Grid>
  </Grid>
</Window>
