<Window x:Class="EQLogParser.DamageOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:fa="http://schemas.fontawesome.com/icons/"
        mc:Ignorable="d"
        AllowsTransparency="True"
        Background="#00000000"
        ShowActivated="False"
        Topmost="True"
        Icon="EQLogParser.ico"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display"
        Title="Damage Meter"
        Margin="0"
        Padding="0"
        BorderBrush="#00000000"
        BorderThickness="1"
        MaxWidth="1500"
        MaxHeight="1000"
        MinWidth="300"
        MouseLeftButtonDown="OverlayMouseLeftDown"
        SizeChanged="WindowSizeChanged"
        ContentRendered="WindowContentRendered"
        UseLayoutRounding="True"
        Closing="WindowClosing"
        Style="{x:Null}"
        WindowStyle="None"
        ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="200*"></RowDefinition>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Vertical">
      <Border x:Name="border" CornerRadius="2">
        <StackPanel Orientation="Vertical">
          <!-- The header is the same five columns as every row, with the same widths, the same right insets and the same words, so a word sits
               over its digits at any font and a switched-off column takes its word with it. DamageOverlayWindow.ApplyColumnLayout hands over all
               three from one MeterColumnLayout, and the words come from MeterColumns — these TextBlocks ship empty because a second copy of
               "% / Damage / DPS / RDPS / Sec" here is a word that can be renamed on its own. The widths below are the 12pt default for the
               designer only; every one is overwritten before the window paints. -->
          <Grid x:Name="controlPanel" Height="18" Margin="0,0,0,2" Visibility="Collapsed">
            <Grid x:Name="headerRow" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="headPercent" Width="0" />
                <ColumnDefinition x:Name="headDamage" Width="60" />
                <ColumnDefinition x:Name="headDPS" Width="60" />
                <ColumnDefinition x:Name="headRDPS" Width="0" />
                <ColumnDefinition x:Name="headTime" Width="45" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="titlePercent" Grid.Column="0" Text="" TextAlignment="Right" FontFamily="Tahoma"
                Foreground="White" />
              <TextBlock x:Name="titleDamage" Grid.Column="1" Text="" TextAlignment="Right" FontFamily="Tahoma"
                Foreground="White" />
              <TextBlock x:Name="titleDPS" Grid.Column="2" Text="" TextAlignment="Right" FontFamily="Tahoma"
                Foreground="White" />
              <TextBlock x:Name="titleRDPS" Grid.Column="3" Text="" TextAlignment="Right" FontFamily="Tahoma"
                Foreground="White" />
              <TextBlock x:Name="titleTime" Grid.Column="4" Text="" TextAlignment="Right" FontFamily="Tahoma"
                Foreground="White" />
            </Grid>
          </Grid>
          <StackPanel x:Name="damageContent" Orientation="Vertical" Visibility="Collapsed" />
          <StackPanel x:Name="tankContent" Orientation="Vertical" Visibility="Collapsed" />
        </StackPanel>
      </Border>
      <Grid x:Name="lineGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"></ColumnDefinition>
          <ColumnDefinition Width="Auto"></ColumnDefinition>
          <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Rectangle Grid.Column="0" x:Name="heightRectangle" Height="2" Fill="{DynamicResource EQStopForegroundBrush}" HorizontalAlignment="Stretch" />
        <TextBlock Grid.Column="1" Margin="2,0,2,0" Padding="0" Foreground="{DynamicResource EQStopForegroundBrush}" FontFamily="Roboto" FontSize="{DynamicResource EQDescriptionSize}" Text="Height Set At This Line" />
        <Rectangle Grid.Column="2" Height="2" Fill="{DynamicResource EQStopForegroundBrush}" HorizontalAlignment="Stretch" />
      </Grid>
    </StackPanel>
  </Grid>
</Window>