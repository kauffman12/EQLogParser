<Window x:Class="EQLogParser.DamageOverlayToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.com/icons/"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        MinHeight="18"
        Style="{x:Null}"
        BorderThickness="0"
        Padding="0"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="False"
        Title="Damage Meter Controls">

  <Window.Resources>
    <Style x:Key="MeterToolbarButton" TargetType="Button">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="FontFamily" Value="Tahoma" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#01000000" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#20FFFFFF" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#40FFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <StackPanel x:Name="toolbarPanel"
              Orientation="Horizontal"
              VerticalAlignment="Top"
              Margin="0,2,0,0"
              Background="Transparent">

    <Button x:Name="configureButton"
            ToolTip="Setup Damage Meter"
            Style="{StaticResource MeterToolbarButton}"
            Margin="2,0,0,0"
            Padding="3,0">
      <fa:ImageAwesome x:Name="configImage"
                       Foreground="{DynamicResource ContentForeground}"
                       Icon="Solid_Cog"
                       Height="12" />
    </Button>

    <Button x:Name="copyButton"
            ToolTip="Copy Parse"
            Style="{StaticResource MeterToolbarButton}"
            Padding="3,0">
      <fa:ImageAwesome x:Name="copyImage"
                       Foreground="{DynamicResource ContentForeground}"
                       Icon="Regular_Copy"
                       Height="12" />
    </Button>

    <Button x:Name="resetButton"
            ToolTip="Clear Parse"
            Style="{StaticResource MeterToolbarButton}"
            Padding="3,0">
      <fa:ImageAwesome x:Name="resetImage"
                       Foreground="{DynamicResource ContentForeground}"
                       Icon="Regular_TrashAlt"
                       Height="12" />
    </Button>

    <Button x:Name="closeButton"
            ToolTip="Close"
            Style="{StaticResource MeterToolbarButton}"
            Padding="3,0">
      <fa:ImageAwesome x:Name="closeImage"
                       Foreground="{DynamicResource ContentForeground}"
                       Icon="Solid_Times"
                       Height="10" />
    </Button>

    <Rectangle x:Name="rect1"
               Width="1"
               Fill="White"
               Height="14"
               VerticalAlignment="Center"
               Margin="4,0,0,0" />

    <Button x:Name="dpsButton"
            Content="DPS"
            Style="{StaticResource MeterToolbarButton}"
            Padding="4,0" />

    <Rectangle x:Name="rect2"
               Width="1"
               Fill="White"
               Height="14"
               VerticalAlignment="Center" />

    <Button x:Name="tankButton"
            Content="Tank"
            Style="{StaticResource MeterToolbarButton}"
            Padding="4,0" />

  </StackPanel>
</Window>
