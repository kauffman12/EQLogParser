<Window x:Class="EQLogParser.DamageOverlayToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.com/icons/"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="Width"
        Height="27"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="False"
        Title="Damage Meter Controls">

  <StackPanel x:Name="toolbarPanel"
              Orientation="Horizontal"
              Margin="0,1,0,2"
              Background="Transparent">

    <Button x:Name="configureButton"
            ToolTip="Setup Damage Meter"
            Margin="2,3,0,0"
            Padding="3"
            Foreground="White"
            Background="Transparent"
            Focusable="False">
      <fa:ImageAwesome x:Name="configImage"
                       Foreground="{DynamicResource ContentForeground}"
                       Icon="Solid_Cog"
                       Height="12" />
    </Button>

    <Button x:Name="copyButton"
            ToolTip="Copy Parse"
            Margin="0,1,0,0"
            Padding="3"
            Foreground="White"
            Background="Transparent"
            Focusable="False">
      <fa:ImageAwesome x:Name="copyImage"
                       Foreground="{DynamicResource ContentForeground}"
                       Icon="Regular_Copy"
                       Height="12" />
    </Button>

    <Button x:Name="resetButton"
            ToolTip="Clear Parse"
            Margin="0,1,0,0"
            Padding="3"
            Foreground="White"
            Background="Transparent"
            Focusable="False">
      <fa:ImageAwesome x:Name="resetImage"
                       Foreground="{DynamicResource ContentForeground}"
                       Icon="Regular_TrashAlt"
                       Height="12" />
    </Button>

    <Button x:Name="closeButton"
            ToolTip="Close"
            Margin="0,1,0,0"
            Padding="3"
            Foreground="White"
            Background="Transparent"
            Focusable="False">
      <fa:ImageAwesome x:Name="closeImage"
                       Foreground="{DynamicResource ContentForeground}"
                       Icon="Solid_Times"
                       Height="10" />
    </Button>

    <Rectangle x:Name="rect1"
               Width="1"
               Fill="White"
               Height="14"
               Margin="4,1,0,0" />

    <Button x:Name="dpsButton"
            Content="DPS"
            FontFamily="Tahoma"
            Margin="0,1,0,1"
            Padding="4"
            FontSize="13"
            Focusable="False"
            BorderBrush="Transparent"
            Foreground="White"
            Background="Transparent" />

    <Rectangle x:Name="rect2"
               Width="1"
               Fill="White"
               Height="14"
               Margin="0,1,0,0" />

    <Button x:Name="tankButton"
            Content="Tank"
            FontFamily="Tahoma"
            Margin="0,1,0,1"
            Padding="4"
            FontSize="13"
            Focusable="False"
            BorderBrush="Transparent"
            Foreground="White"
            Background="Transparent" />

  </StackPanel>
</Window>
