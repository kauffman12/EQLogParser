<Window x:Class="EQLogParser.FctSimulationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EQLogParser"
        mc:Ignorable="d"
        AllowsTransparency="True"
        Background="#00000000"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display"
        Title="FCT Simulation"
        Width="980"
        Height="640"
        UseLayoutRounding="True"
        WindowStyle="None"
        KeyDown="WindowKeyDown">
  <Border CornerRadius="10" Background="#F50D131A" BorderBrush="#5C7A99" BorderThickness="1" MouseLeftButtonUp="RootMouseLeftButtonUp">
    <Grid Margin="16,12,16,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="2,0,2,8">
        <TextBlock x:Name="titleText" FontSize="14" FontWeight="Bold" Foreground="#D6E1EC" />
        <TextBlock x:Name="statsText" Margin="0,3,0,0" FontSize="12" Foreground="#7FD1FF" />
        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#6B7A8C" Text="Click or press Esc to stop early. Auto-closes when the 60 seconds are up." />
      </StackPanel>
      <local:FctSimCanvas x:Name="fctCanvas" Grid.Row="1" />
      <local:FctSkiaCanvas x:Name="fctSkiaCanvas" Grid.Row="1" Visibility="Collapsed" />
    </Grid>
  </Border>
</Window>
